# 复制成 .env 后改；启动时自动读取（放在 server/backend/ 下，从这个目录启动才生效）
# 注意：管理员密码只在首次建库时使用，之后改密码用 python tools/set_admin.py

# 管理端账号密码
E0E1_ADMIN_USERNAME=admin
E0E1_ADMIN_PASSWORD=换成你自己的密码

# 监听地址
E0E1_HTTP_HOST=0.0.0.0
E0E1_HTTP_PORT=8000
E0E1_GRPC_HOST=0.0.0.0
E0E1_GRPC_PORT=8001

# 插件下载更新文件时用的对外地址（证书 SAN 里的主机名要和这里一致）
E0E1_PUBLIC_BASE_URL=https://你的域名:8000

# JWT 密钥，务必换成随机长串
E0E1_JWT_SECRET=换成随机的长字符串
